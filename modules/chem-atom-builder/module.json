{
  "schemaVersion": "1.0",
  "releaseStatus": "draft",
  "id": "chem.atom-builder",
  "title": { "en": "Atom Builder" },
  "subject": "chemistry",
  "kit": "chemistry",
  "concepts": [
    "sci.chem.atom.structure",
    "sci.chem.atom.shells",
    "sci.chem.atom.ions",
    "sci.chem.atom.isotopes"
  ],
  "boards": ["CBSE", "ICSE", "STATE"],
  "levels": [
    { "id": "class9-10", "classes": [9, 10], "features": ["particles", "shells", "ions"] }
  ],
  "modes": ["screen"],
  "estimatedMinutes": 8,
  "assets": [],
  "interactions": {
    "manipulate": ["drag-particles", "snap-to-nucleus", "snap-to-shell", "orbit-camera"],
    "simulate": ["update-element", "update-charge", "update-electron-configuration"],
    "missions": ["build-carbon-12", "make-na-plus", "build-carbon-14", "make-cl-minus"],
    "check": [
      "assess.atom.carbon12.01",
      "assess.atom.carbon12.02",
      "assess.atom.sodium-ion.01",
      "assess.atom.sodium-ion.02",
      "assess.atom.carbon14.01",
      "assess.atom.carbon14.02",
      "assess.atom.chloride-ion.01",
      "assess.atom.chloride-ion.02"
    ]
  },
  "missions": [
    {
      "id": "build-carbon-12",
      "title": "Build carbon-12",
      "goalText": "Build a neutral carbon atom with 6 protons, 6 neutrons, and 6 electrons.",
      "goal": { "symbol": "C", "protons": 6, "neutrons": 6, "electrons": 6, "massNumber": 12, "charge": 0 },
      "hints": [
        "Start with the proton count.",
        "Carbon is C. Set 6 protons and 6 neutrons.",
        "Carbon-12 needs 6 protons and 6 neutrons. Neutral means 6 electrons too."
      ],
      "onComplete": { "triggerAssessments": ["assess.atom.carbon12.01", "assess.atom.carbon12.02"] }
    },
    {
      "id": "make-na-plus",
      "title": "Make Na+",
      "goalText": "Build Na+ with 11 protons, 12 neutrons, 10 electrons, and configuration 2,8.",
      "goal": { "symbol": "Na", "protons": 11, "neutrons": 12, "electrons": 10, "charge": 1, "electronConfiguration": [2, 8] },
      "hints": [
        "Check what Na+ says about charge.",
        "Sodium has 11 protons; +1 means one fewer electron.",
        "Use 11 protons, 12 neutrons, and 10 electrons. Those electrons fill 2,8."
      ],
      "onComplete": { "triggerAssessments": ["assess.atom.sodium-ion.01", "assess.atom.sodium-ion.02"] }
    },
    {
      "id": "build-carbon-14",
      "title": "Build carbon-14",
      "goalText": "Build carbon-14 with 6 protons, 8 neutrons, 6 electrons, and charge 0.",
      "goal": { "symbol": "C", "massNumber": 14, "charge": 0, "protons": 6, "neutrons": 8, "electrons": 6 },
      "hints": [
        "Compare the mass number with the proton count.",
        "Carbon has 6 protons. Use mass number 14 to find its neutrons.",
        "14 - 6 = 8 neutrons. Charge 0 means 6 electrons."
      ],
      "onComplete": { "triggerAssessments": ["assess.atom.carbon14.01", "assess.atom.carbon14.02"] }
    },
    {
      "id": "make-cl-minus",
      "title": "Make Cl-",
      "goalText": "Build Cl- with 17 protons, 18 neutrons, 18 electrons, and a complete outer shell.",
      "goal": { "symbol": "Cl", "charge": -1, "protons": 17, "neutrons": 18, "electrons": 18, "electronConfiguration": [2, 8, 8], "outerShellComplete": true },
      "hints": [
        "A negative charge means an extra electron.",
        "Chlorine has 17 protons; add one electron for -1.",
        "Use 17 protons, 18 neutrons, and 18 electrons. Shells 2,8,8 make a complete outer shell."
      ],
      "onComplete": { "triggerAssessments": ["assess.atom.chloride-ion.01", "assess.atom.chloride-ion.02"] }
    }
  ],
  "narration": {
    "languages": ["en"],
    "cues": [
      {
        "id": "module-started",
        "trigger": "module_started",
        "script": "narration/en/module-started.json",
        "audio": "narration/en/generated/module-started.wav.gz",
        "captions": "narration/en/generated/module-started.vtt",
        "captionText": "Welcome to Atom Builder. Add particles to build each atom or ion, then check your model. You can follow the captions with sound off.",
        "interruptible": true
      },
      {
        "id": "build-carbon-12-start",
        "trigger": "mission_started",
        "missionId": "build-carbon-12",
        "script": "narration/en/build-carbon-12-start.json",
        "audio": "narration/en/generated/build-carbon-12-start.wav.gz",
        "captions": "narration/en/generated/build-carbon-12-start.vtt",
        "captionText": "Build carbon-12. Start with six protons and six neutrons. Add six electrons too, because the atom is neutral.",
        "interruptible": true
      },
      {
        "id": "build-carbon-12-complete",
        "trigger": "mission_completed",
        "missionId": "build-carbon-12",
        "script": "narration/en/build-carbon-12-complete.json",
        "audio": "narration/en/generated/build-carbon-12-complete.wav.gz",
        "captions": "narration/en/generated/build-carbon-12-complete.vtt",
        "captionText": "Carbon-12 is ready: six protons, six neutrons, and six electrons. Continue to the questions when you are ready.",
        "interruptible": true
      },
      {
        "id": "make-na-plus-start",
        "trigger": "mission_started",
        "missionId": "make-na-plus",
        "script": "narration/en/make-na-plus-start.json",
        "audio": "narration/en/generated/make-na-plus-start.wav.gz",
        "captions": "narration/en/generated/make-na-plus-start.vtt",
        "captionText": "Now make Na plus. Sodium has eleven protons. A plus-one charge means it has lost one electron.",
        "interruptible": true
      },
      {
        "id": "make-na-plus-complete",
        "trigger": "mission_completed",
        "missionId": "make-na-plus",
        "script": "narration/en/make-na-plus-complete.json",
        "audio": "narration/en/generated/make-na-plus-complete.wav.gz",
        "captions": "narration/en/generated/make-na-plus-complete.vtt",
        "captionText": "Na plus has eleven protons, twelve neutrons, and ten electrons. Its electron configuration is two, eight.",
        "interruptible": true
      },
      {
        "id": "build-carbon-14-start",
        "trigger": "mission_started",
        "missionId": "build-carbon-14",
        "script": "narration/en/build-carbon-14-start.json",
        "audio": "narration/en/generated/build-carbon-14-start.wav.gz",
        "captions": "narration/en/generated/build-carbon-14-start.vtt",
        "captionText": "Build carbon-14. It has six protons. Compare mass number fourteen with the proton count to find its neutrons.",
        "interruptible": true
      },
      {
        "id": "build-carbon-14-complete",
        "trigger": "mission_completed",
        "missionId": "build-carbon-14",
        "script": "narration/en/build-carbon-14-complete.json",
        "audio": "narration/en/generated/build-carbon-14-complete.wav.gz",
        "captions": "narration/en/generated/build-carbon-14-complete.vtt",
        "captionText": "Carbon-14 has six protons, eight neutrons, and six electrons. Its charge is zero.",
        "interruptible": true
      },
      {
        "id": "make-cl-minus-start",
        "trigger": "mission_started",
        "missionId": "make-cl-minus",
        "script": "narration/en/make-cl-minus-start.json",
        "audio": "narration/en/generated/make-cl-minus-start.wav.gz",
        "captions": "narration/en/generated/make-cl-minus-start.vtt",
        "captionText": "Make Cl minus. Chlorine has seventeen protons. A negative charge means one extra electron.",
        "interruptible": true
      },
      {
        "id": "make-cl-minus-complete",
        "trigger": "mission_completed",
        "missionId": "make-cl-minus",
        "script": "narration/en/make-cl-minus-complete.json",
        "audio": "narration/en/generated/make-cl-minus-complete.wav.gz",
        "captions": "narration/en/generated/make-cl-minus-complete.vtt",
        "captionText": "Cl minus has seventeen protons, eighteen neutrons, and electron configuration two, eight, eight, with a complete outer shell.",
        "interruptible": true
      },
      {
        "id": "invalid-placement",
        "trigger": "invalid_placement",
        "script": "narration/en/invalid-placement.json",
        "audio": "narration/en/generated/invalid-placement.wav.gz",
        "captions": "narration/en/generated/invalid-placement.vtt",
        "captionText": "That spot does not work for this particle or shell. Check the feedback and try another position.",
        "interruptible": true
      }
    ],
    "guide": {
      "enabled": false,
      "allowedActions": ["highlight", "show_hint", "focus_camera", "open_panel", "start_mission"],
      "groundingDocs": []
    }
  },
  "rulesPlugin": "./src/index.ts"
}