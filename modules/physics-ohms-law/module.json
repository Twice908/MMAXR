  "missions": [
    {
      "id": "build-circuit",
      "title": "Connect the meters",
      "goalText": "Put the ammeter in series and the voltmeter across the resistor. Then close the switch so current flows.",
      "goal": {
        "ammeterInSeries": true,
        "voltmeterAcrossLoad": true,
        "switchClosed": true
      },
      "hints": [
        "An ammeter measures the current, so the current must flow through it. It goes in series, in the gap in the loop.",
        "A voltmeter measures the potential difference between the two ends of a part. It goes across (in parallel with) the resistor.",
        "Choose Ammeter and place it in the gap. Choose Voltmeter and place it across the resistor. Close the switch, then press Check."
      ],
      "onComplete": {
        "triggerAssessments": [
          "assess.ohm.meters.01",
          "assess.ohm.meters.02"
        ]
      }
    },
    {
      "id": "vary-potential-difference",
      "title": "Change the potential difference",
      "goalText": "Keep one resistor. Record readings with at least three different numbers of cells, and watch how the current changes.",
      "goal": {
        "variedPotentialDifference": true
      },
      "hints": [
        "Each cell adds 1.5 V of potential difference across the resistor.",
        "Add a cell with +, then press Record reading. Do this for at least three different numbers of cells.",
        "Look at the V ÷ I column. For the same resistor it stays the same, and the graph is a straight line through the origin."
      ],
      "onComplete": {
        "triggerAssessments": [
          "assess.ohm.voltage.01",
          "assess.ohm.voltage.02"
        ]
      }
    },
    {
      "id": "vary-resistance",
      "title": "Change the resistance",
      "goalText": "Keep the same number of cells. Record a reading with each resistor: 2 Ω, 5 Ω and 10 Ω.",
      "goal": {
        "variedResistance": true
      },
      "hints": [
        "Do not change the cells this time. Only change the resistor.",
        "Choose a resistor under Part to test, then press Record reading. Do this for all three resistors.",
        "Compare the currents. The larger the resistance, the smaller the current for the same potential difference."
      ],
      "onComplete": {
        "triggerAssessments": [
          "assess.ohm.resistance.01",
          "assess.ohm.resistance.02"
        ]
      }
    },
    {
      "id": "filament-bulb",
      "title": "Test a filament bulb",
      "goalText": "Swap the resistor for the bulb. Record readings with at least three different numbers of cells, then compare its graph with the resistor's.",
      "goal": {
        "bulbTested": true
      },
      "hints": [
        "Choose Bulb under Part to test. The voltmeter stays across it.",
        "Record a reading, add a cell, and record again. Do this at least three times.",
        "Look at V ÷ I for the bulb. It grows as the bulb gets brighter and hotter, so its graph curves."
      ],
      "onComplete": {
        "triggerAssessments": [
          "assess.ohm.bulb.01",
          "assess.ohm.bulb.02"
        ]
      }
    }
  ],
