  "missions": [
    {
      "id": "give-electron",
      "title": "Move an electron",
      "goalText": "Give sodium's outer electron to chlorine, so both end with a complete outer shell (an octet).",
      "goal": {
        "compound": "nacl",
        "ions": [
          "Na+",
          "Cl-"
        ],
        "allOuterShellsComplete": true
      },
      "hints": [
        "Look at the outer shells. Sodium has 1 outer electron. Chlorine has 7.",
        "Sodium is the metal, so it gives. Chlorine is the non-metal, so it takes.",
        "Drag sodium's outer electron onto chlorine, or tap sodium and then tap chlorine. Then press Check."
      ],
      "onComplete": {
        "triggerAssessments": [
          "assess.ionic.transfer.01",
          "assess.ionic.transfer.02"
        ]
      }
    },
    {
      "id": "join-ions",
      "title": "Join the ions",
      "goalText": "Join Na+ and Cl- to make sodium chloride, NaCl.",
      "goal": {
        "compound": "nacl",
        "bonded": true,
        "formula": "NaCl"
      },
      "hints": [
        "Na+ is positive and Cl- is negative. Opposite charges attract.",
        "Both ions already have a complete outer shell, so they are ready to join.",
        "Press Join the ions, then press Check."
      ],
      "onComplete": {
        "triggerAssessments": [
          "assess.ionic.bond.01",
          "assess.ionic.bond.02"
        ]
      }
    }
  ],
